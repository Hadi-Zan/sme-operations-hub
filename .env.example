# Supabase project values from the project's Connect dialog.
# Copy this file to .env.local and replace the placeholders locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Use the canonical HTTPS deployment origin in production. Local HTTP is
# accepted only outside production.
APP_BASE_URL=http://localhost:3000
